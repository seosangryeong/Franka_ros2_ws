diff --git a/franka_fr3_moveit_config/launch/franka_control.launch.py b/franka_fr3_moveit_config/launch/franka_control.launch.py
new file mode 100644
index 0000000..07c1504
--- /dev/null
+++ b/franka_fr3_moveit_config/launch/franka_control.launch.py
@@ -0,0 +1,54 @@
+"""Unified FR3 hardware, trajectory controller, MoveIt and RViz launch.
+
+Defaults to fake hardware and planning only. On a real robot the arm
+trajectory controller is loaded inactive; activate it explicitly for motion.
+"""
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, OpaqueFunction
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch.conditions import IfCondition
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+from pathlib import Path
+
+
+def launch_nodes(context):
+    fake = LaunchConfiguration('use_fake_hardware').perform(context).lower() == 'true'
+    gripper = LaunchConfiguration('load_gripper').perform(context).lower()
+    address = LaunchConfiguration('robot_ip').perform(context)
+    execute = LaunchConfiguration('execute').perform(context)
+    share = Path(get_package_share_directory('franka_fr3_moveit_config'))
+    bringup = Path(get_package_share_directory('franka_bringup'))
+    hardware = IncludeLaunchDescription(
+        PythonLaunchDescriptionSource(str(bringup/'launch/franka.launch.py')),
+        launch_arguments={'arm_id': 'fr3', 'robot_ip': address,
+                          'use_fake_hardware': str(fake).lower(),
+                          'load_gripper': gripper}.items())
+    config = 'fr3_arm_controller_fake.yaml' if fake else 'fr3_arm_controller_real.yaml'
+    arguments = ['fr3_arm_controller', '--controller-manager', '/controller_manager',
+                 '--controller-manager-timeout', '60', '--param-file', str(share/'config'/config)]
+    if not fake:
+        arguments.append('--inactive')
+    controller = Node(package='controller_manager', executable='spawner',
+                      arguments=arguments, output='screen')
+    moveit = IncludeLaunchDescription(
+        PythonLaunchDescriptionSource(str(share/'launch/move_group.launch.py')),
+        launch_arguments={'robot_ip': address, 'load_gripper': gripper,
+                          'use_fake_hardware': str(fake).lower(), 'execute': execute,
+                          'use_rviz': LaunchConfiguration('use_rviz').perform(context)}.items())
+    scene = Node(package='fr3_skills', executable='planning_scene', output='screen',
+                 condition=IfCondition(LaunchConfiguration('load_table')))
+    return [hardware, controller, moveit, scene]
+
+
+def generate_launch_description():
+    return LaunchDescription([
+        DeclareLaunchArgument('robot_ip', default_value='172.16.0.2'),
+        DeclareLaunchArgument('use_fake_hardware', default_value='true'),
+        DeclareLaunchArgument('load_gripper', default_value='true'),
+        DeclareLaunchArgument('execute', default_value='false'),
+        DeclareLaunchArgument('use_rviz', default_value='true'),
+        DeclareLaunchArgument('load_table', default_value='false'),
+        OpaqueFunction(function=launch_nodes),
+    ])
diff --git a/franka_fr3_moveit_config/launch/xbox_teleop.launch.py b/franka_fr3_moveit_config/launch/xbox_teleop.launch.py
new file mode 100644
index 0000000..043e084
--- /dev/null
+++ b/franka_fr3_moveit_config/launch/xbox_teleop.launch.py
@@ -0,0 +1,52 @@
+"""FR3 Xbox teleoperation. Real arm controller remains inactive at startup."""
+from pathlib import Path
+import yaml
+import xacro
+from ament_index_python.packages import get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument, IncludeLaunchDescription, OpaqueFunction
+from launch.conditions import IfCondition
+from launch.launch_description_sources import PythonLaunchDescriptionSource
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+from launch_ros.parameter_descriptions import ParameterValue
+
+
+def nodes(context):
+    share = Path(get_package_share_directory('franka_fr3_moveit_config'))
+    description = Path(get_package_share_directory('franka_description'))
+    fake = LaunchConfiguration('use_fake_hardware').perform(context)
+    hand = LaunchConfiguration('load_gripper').perform(context)
+    robot = {'robot_description': xacro.process_file(str(description/'robots/fr3/fr3.urdf.xacro'),
+             mappings={'arm_id': 'fr3', 'hand': hand, 'ros2_control': 'false'}).toxml()}
+    semantic = {'robot_description_semantic': xacro.process_file(str(description/'robots/fr3/fr3.srdf.xacro'),
+                mappings={'hand': hand}).toxml()}
+    with (share/'config/kinematics.yaml').open() as f:
+        kinematics = {'robot_description_kinematics': yaml.safe_load(f)}
+    with (share/'config/fr3_servo.yaml').open() as f:
+        servo = {'moveit_servo': yaml.safe_load(f)}
+    return [
+        IncludeLaunchDescription(PythonLaunchDescriptionSource(str(share/'launch/franka_control.launch.py')),
+            launch_arguments={'robot_ip': LaunchConfiguration('robot_ip').perform(context),
+                'use_fake_hardware': fake, 'load_gripper': hand, 'execute': 'false',
+                'load_table': 'true', 'use_rviz': LaunchConfiguration('use_rviz').perform(context)}.items()),
+        Node(package='moveit_servo', executable='servo_node_main', name='servo_node', output='screen',
+             parameters=[robot, semantic, kinematics, servo]),
+        Node(package='joy', executable='joy_node', name='fr3_joy', output='screen',
+             parameters=[{'device_id': ParameterValue(LaunchConfiguration('device_id'), value_type=int), 'deadzone': 0.05,
+                          'autorepeat_rate': 50.0}], remappings=[('joy', '/fr3/joy')],
+             condition=IfCondition(LaunchConfiguration('start_joy'))),
+        Node(package='fr3_skills', executable='xbox_teleop', output='screen'),
+    ]
+
+
+def generate_launch_description():
+    return LaunchDescription([
+        DeclareLaunchArgument('robot_ip', default_value='172.16.0.2'),
+        DeclareLaunchArgument('use_fake_hardware', default_value='true'),
+        DeclareLaunchArgument('load_gripper', default_value='true'),
+        DeclareLaunchArgument('use_rviz', default_value='true'),
+        DeclareLaunchArgument('device_id', default_value='0'),
+        DeclareLaunchArgument('start_joy', default_value='true'),
+        OpaqueFunction(function=nodes),
+    ])
